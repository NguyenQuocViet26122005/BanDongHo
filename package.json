{
  "name": "aurel-watch-qa",
  "version": "1.4.0",
  "private": true,
  "description": "AUREL — giao diện cửa hàng và bộ thực hành kiểm thử local",
  "scripts": {
    "test": "node --test tests/unit/store.test.js tests/unit/demo-data.test.js tests/unit/storefront.test.js",
    "check": "node scripts/check-syntax.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "report": "playwright show-report",
    "serve:test": "node scripts/test-server.cjs",
    "start": "node scripts/test-server.cjs",
    "build:jmeter": "node scripts/build-jmeter-performance.cjs",
    "build:ide": "node scripts/build-selenium-ide.cjs",
    "check:links": "node scripts/check-links.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0"
  }
}
